<Configuration>
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <vGPU>Disable</vGPU>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\v9-stage\in</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\h3-in</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\v9-stage\out</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\h3-out</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\v9-stage\py-embed</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\h3-py</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>"C:\Users\WDAGUtilityAccount\Desktop\h3-py\python.exe" "C:\Users\WDAGUtilityAccount\Desktop\h3-in\sandbox_agent.py" --inbox "C:\Users\WDAGUtilityAccount\Desktop\h3-in" --outbox "C:\Users\WDAGUtilityAccount\Desktop\h3-out" --handshake-only</Command>
  </LogonCommand>
</Configuration>
