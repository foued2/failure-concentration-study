{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foued2/failure-concentration-study/census-intake/record_schema/v0.2.json",
  "schema_version": "0.2",
  "title": "B1 v1.7 census intake contract (descriptive, partial)",
  "description": "SYNTACTIC INTAKE ONLY — PROVENANCE NOT VERIFIED. Descriptive contract for the fields enforced by validate_records.py v0.2. It is not the reviewed revision 0.6 census manifest schema and does not claim full draft 2020-12 or 0.6 conformance; the Python validator implements the checks explicitly with the standard library.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "measurement_basis", "diagnostic_bank", "parent_roster", "variants", "outcome_exclusion_assertion"],
  "properties": {
    "schema_version": { "const": "0.6-draft" },
    "study_id": { "const": "LC518" },
    "measurement_basis": { "const": "record_level_64" },
    "diagnostic_bank": {
      "type": "object",
      "required": ["stratum_ids", "records_per_stratum", "total_records"],
      "properties": {
        "stratum_ids": { "type": "array", "const": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"] },
        "records_per_stratum": { "const": 8 },
        "total_records": { "const": 64 }
      }
    },
    "parent_roster": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["parent_id", "Z_id"],
        "properties": {
          "parent_id": { "type": "string", "minLength": 1 },
          "Z_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variant" }
    },
    "outcome_exclusion_assertion": {
      "type": "object",
      "required": ["correctness_outcomes_included", "outcomes_consulted", "model_outputs_included"],
      "properties": {
        "correctness_outcomes_included": { "const": false },
        "outcomes_consulted": { "const": false },
        "model_outputs_included": { "const": false }
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "required": ["variant_id", "parent_id", "Z_id", "q_id", "validity_status", "diagnostic_record_results"],
      "properties": {
        "variant_id": { "type": "string", "minLength": 1 },
        "parent_id": { "type": "string", "minLength": 1 },
        "Z_id": { "type": "string", "minLength": 1 },
        "q_id": { "type": "string", "minLength": 1 },
        "validity_status": {
          "enum": ["VALID", "INVALID", "EXCLUDED_BEFORE_DIAGNOSTICS", "INCOMPLETE", "EXPECTED_NOT_RUN"]
        },
        "diagnostic_record_results": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/diagnosticRecordResult" }
        },
        "semantic_source_digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "runnable_artifact_digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "status_reason": { "type": "string", "minLength": 1 },
        "status_decision": { "type": "object" },
        "diagnostic_evidence_ref": { "type": "object" },
        "f": { "$ref": "#/$defs/vector8" },
        "u": { "$ref": "#/$defs/vector8" },
        "p": { "$ref": "#/$defs/vector8" }
      }
    },
    "diagnosticRecordResult": {
      "type": "object",
      "required": ["diagnostic_record_id", "stratum_id", "terminal_status"],
      "properties": {
        "diagnostic_record_id": { "type": "string", "minLength": 1 },
        "stratum_id": { "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"] },
        "terminal_status": { "enum": ["DEFINITE_PASS", "DEFINITE_FAILURE", "UNRESOLVED"] }
      }
    },
    "vector8": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
