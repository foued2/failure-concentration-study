{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc518:b1-v1.7:census-manifest:0.6-draft",
  "title": "LC518 B1 v1.7 outcome-blind census manifest schema (draft 0.6)",
  "description": "B1 v1.7-specific outcome-blind manifest schema draft 0.6. The schema $id carries the same revision identifier as schema_version and must be updated with it for every versioned schema revision. N_eval_rows is fixed at 78 by this instrument version; the referenced frozen B1 v1.7 development evaluation-row configuration must confirm 78. Executable logic must read evaluation_row_basis.row_count from the validated manifest and must not hardcode an independent constant. Any different evaluation target or row count requires a formal B1 analysis-plan amendment and a new reviewed, frozen, versioned and hash-identified instrument and schema. This is a design-count input only and does not designate the evaluation route as confirmatory. Cross-file identity and run-ledger checks remain semantic-validator responsibilities. Historical public-bank exposure is separate from future bank-generation selection policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "analysis_plan",
    "measurement_spec",
    "measurement_basis",
    "evaluation_row_basis",
    "diagnostic_bank",
    "diagnostic_exposure_disclosure",
    "parent_roster_ref",
    "q_registry_ref",
    "family_map_ref",
    "variant_inventory_ref",
    "diagnostic_run_start_ledger",
    "provenance",
    "parent_roster",
    "variants",
    "outcome_exclusion_assertion"
  ],
  "properties": {
    "schema_version": {
      "const": "0.6-draft"
    },
    "study_id": {
      "const": "LC518"
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "git_blob_sha1",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "B1"
        },
        "version": {
          "const": "1.7"
        },
        "git_blob_sha1": {
          "const": "8c666e501a31726c728447d155045c0b20adc178"
        },
        "sha256": {
          "const": "797bd9f72cf94fdc0eff4a03b1544823d4042f8e530b27f4fb70cbd7f2baca7c"
        }
      }
    },
    "measurement_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "date",
        "git_blob_sha1"
      ],
      "properties": {
        "name": {
          "const": "C_D measurement specification and exposure register"
        },
        "date": {
          "const": "2026-11-19"
        },
        "git_blob_sha1": {
          "const": "923655f20337b99f11e400f3428d1d18ac34c96d"
        }
      }
    },
    "measurement_basis": {
      "const": "record_level_64"
    },
    "diagnostic_bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bank_id",
        "version",
        "sha256",
        "record_manifest_sha256",
        "stratum_ids",
        "records_per_stratum",
        "total_records"
      ],
      "properties": {
        "bank_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "record_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "stratum_ids": {
          "type": "array",
          "const": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6",
            "D7",
            "D8"
          ]
        },
        "records_per_stratum": {
          "const": 8
        },
        "total_records": {
          "const": 64
        }
      }
    },
    "parent_roster_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "q_registry_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "family_map_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "variant_inventory_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_record_ref",
        "build_record_ref",
        "diagnostic_run_record_ref"
      ],
      "properties": {
        "generation_record_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "build_record_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "diagnostic_run_record_ref": {
          "$ref": "#/$defs/evidenceRef"
        }
      }
    },
    "parent_roster": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent_id",
          "Z_id"
        ],
        "properties": {
          "parent_id": {
            "type": "string",
            "minLength": 1
          },
          "Z_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "outcome_exclusion_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness_outcomes_included",
        "outcomes_consulted",
        "model_outputs_included"
      ],
      "properties": {
        "correctness_outcomes_included": {
          "const": false
        },
        "outcomes_consulted": {
          "const": false
        },
        "model_outputs_included": {
          "const": false
        }
      }
    },
    "diagnostic_exposure_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Historical H80 exposure facts are constants for the existing LC518 D1-D8 lineage. Future diagnostic-bank generation selection is represented separately and does not alter the historical facts or permit an independence claim.",
      "required": [
        "historical_public_heldout_bank_status",
        "historical_used_for_candidate_filtering",
        "historical_selection_history_status",
        "historical_selection_description",
        "future_bank_generation_selection_status",
        "independence_claim_permitted",
        "evidence_refs"
      ],
      "properties": {
        "historical_public_heldout_bank_status": {
          "const": "PUBLICLY_EXPOSED",
          "description": "Fixed historical fact for the H80 B1 bank and the already-screened D1-D8 candidate lineage."
        },
        "historical_used_for_candidate_filtering": {
          "const": true,
          "description": "Fixed historical fact: the publicly exposed H80 bank was used to screen diagnostic candidates."
        },
        "historical_selection_history_status": {
          "enum": [
            "FULLY_DOCUMENTED",
            "PARTIALLY_DOCUMENTED",
            "NOT_RECONSTRUCTED"
          ]
        },
        "historical_selection_description": {
          "type": "string",
          "minLength": 1
        },
        "historical_selection_rule_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "historical_candidate_pool_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "future_bank_generation_selection_status": {
          "enum": [
            "USES_PUBLIC_HELDOUT_INFORMATION",
            "DOES_NOT_USE_PUBLIC_HELDOUT_INFORMATION",
            "NOT_YET_SPECIFIED"
          ]
        },
        "future_bank_generation_protocol_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "independence_claim_permitted": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "future_bank_generation_selection_status": {
                "enum": [
                  "USES_PUBLIC_HELDOUT_INFORMATION",
                  "DOES_NOT_USE_PUBLIC_HELDOUT_INFORMATION"
                ]
              }
            },
            "required": [
              "future_bank_generation_selection_status"
            ]
          },
          "then": {
            "required": [
              "future_bank_generation_protocol_ref"
            ]
          }
        }
      ]
    },
    "diagnostic_run_start_ledger": {
      "type": "object",
      "additionalProperties": false,
      "description": "Frozen-inventory run-start ledger. The referenced ledger must contain exactly one row per expected variant_id, with execution_state NOT_STARTED, STARTED, COMPLETED or ABORTED; started rows carry per-variant start timestamps. first_diagnostic_execution_started_at_utc equals the earliest per-variant start, or is null if and only if every row is NOT_STARTED. The semantic validator also reconciles each variant status with its ledger state: VALID=COMPLETED; INCOMPLETE=STARTED/COMPLETED/ABORTED; EXPECTED_NOT_RUN/INVALID/EXCLUDED_BEFORE_DIAGNOSTICS=NOT_STARTED.",
      "required": [
        "ledger_ref",
        "first_diagnostic_execution_started_at_utc",
        "snapshot_as_of_utc"
      ],
      "properties": {
        "ledger_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "first_diagnostic_execution_started_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "snapshot_as_of_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evaluation_row_basis": {
      "type": "object",
      "additionalProperties": false,
      "description": "N_eval_rows is fixed at 78 by this instrument version. The referenced frozen B1 v1.7 development evaluation-row configuration must confirm 78 through this object's source_ref. Executable logic must read the validated row_count field and must not hardcode an independent constant. Any different evaluation target or row count requires a formal B1 analysis-plan amendment and a new reviewed, frozen, versioned and hash-identified instrument and schema. This is a design-count input only and does not designate the evaluation route as confirmatory.",
      "required": [
        "row_count",
        "source_ref"
      ],
      "properties": {
        "row_count": {
          "const": 78,
          "description": "Fixed expected canonical-record count under the accepted B1 v1.7 development configuration."
        },
        "source_ref": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "git_blob_sha1",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "sha256"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "diagnosticRecordResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_record_id",
        "stratum_id",
        "terminal_status"
      ],
      "properties": {
        "diagnostic_record_id": {
          "type": "string",
          "minLength": 1
        },
        "stratum_id": {
          "enum": [
            "D1",
            "D2",
            "D3",
            "D4",
            "D5",
            "D6",
            "D7",
            "D8"
          ]
        },
        "terminal_status": {
          "enum": [
            "DEFINITE_PASS",
            "DEFINITE_FAILURE",
            "UNRESOLVED"
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "parent_id",
        "Z_id",
        "q_id",
        "validity_status",
        "diagnostic_record_results"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "Z_id": {
          "type": "string",
          "minLength": 1
        },
        "q_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_source_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "runnable_artifact_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "validity_status": {
          "enum": [
            "VALID",
            "INVALID",
            "EXCLUDED_BEFORE_DIAGNOSTICS",
            "INCOMPLETE",
            "EXPECTED_NOT_RUN"
          ]
        },
        "status_reason": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_record_results": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/diagnosticRecordResult"
          }
        },
        "diagnostic_evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "status_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_ref",
            "decision_record_ref",
            "decided_at_utc",
            "decision_basis",
            "diagnostic_terminal_values_consulted",
            "derived_failure_unresolved_counts_consulted",
            "record_presence_identity_metadata_consulted"
          ],
          "properties": {
            "rule_ref": {
              "$ref": "#/$defs/artifactRef"
            },
            "decision_record_ref": {
              "$ref": "#/$defs/evidenceRef"
            },
            "decided_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "decision_basis": {
              "enum": [
                "PREDIAGNOSTIC_DESIGN_EXCLUSION",
                "PREDIAGNOSTIC_OBJECTIVE_INVALIDITY",
                "POSTRUN_COMPLETENESS_AUDIT",
                "EXPECTED_NOT_RUN_INVENTORY_AUDIT"
              ]
            },
            "diagnostic_terminal_values_consulted": {
              "const": false
            },
            "derived_failure_unresolved_counts_consulted": {
              "const": false
            },
            "record_presence_identity_metadata_consulted": {
              "type": "boolean"
            }
          },
          "description": "Evidence-backed status decision. Terminal result values and derived failure/unresolved counts are prohibited inputs. Record-presence/identity metadata is separately declared and only permitted for post-run completeness audits."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validity_status": {
                "const": "VALID"
              }
            },
            "required": [
              "validity_status"
            ]
          },
          "then": {
            "required": [
              "diagnostic_evidence_ref",
              "semantic_source_digest",
              "runnable_artifact_digest"
            ],
            "properties": {
              "diagnostic_record_results": {
                "minItems": 64,
                "maxItems": 64,
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D1"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D2"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D3"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D4"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D5"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D6"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D7"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  },
                  {
                    "contains": {
                      "properties": {
                        "stratum_id": {
                          "const": "D8"
                        }
                      },
                      "required": [
                        "stratum_id"
                      ]
                    },
                    "minContains": 8,
                    "maxContains": 8
                  }
                ]
              }
            }
          },
          "else": {
            "required": [
              "status_reason",
              "status_decision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "validity_status": {
                "enum": [
                  "EXCLUDED_BEFORE_DIAGNOSTICS",
                  "INVALID"
                ]
              }
            },
            "required": [
              "validity_status"
            ]
          },
          "then": {
            "properties": {
              "diagnostic_record_results": {
                "maxItems": 0
              },
              "status_decision": {
                "properties": {
                  "record_presence_identity_metadata_consulted": {
                    "const": false
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "validity_status": {
                      "const": "EXCLUDED_BEFORE_DIAGNOSTICS"
                    }
                  },
                  "required": [
                    "validity_status"
                  ]
                },
                "then": {
                  "properties": {
                    "status_decision": {
                      "properties": {
                        "decision_basis": {
                          "const": "PREDIAGNOSTIC_DESIGN_EXCLUSION"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "validity_status": {
                      "const": "INVALID"
                    }
                  },
                  "required": [
                    "validity_status"
                  ]
                },
                "then": {
                  "properties": {
                    "status_decision": {
                      "properties": {
                        "decision_basis": {
                          "const": "PREDIAGNOSTIC_OBJECTIVE_INVALIDITY"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "validity_status": {
                "const": "INCOMPLETE"
              }
            },
            "required": [
              "validity_status"
            ]
          },
          "then": {
            "properties": {
              "diagnostic_record_results": {
                "maxItems": 63
              },
              "status_decision": {
                "properties": {
                  "decision_basis": {
                    "const": "POSTRUN_COMPLETENESS_AUDIT"
                  },
                  "record_presence_identity_metadata_consulted": {
                    "const": true
                  }
                }
              }
            },
            "required": [
              "diagnostic_evidence_ref"
            ],
            "description": "INCOMPLETE requires retained diagnostic run/receipt evidence even when zero diagnostic result records were received."
          }
        },
        {
          "if": {
            "properties": {
              "validity_status": {
                "const": "EXPECTED_NOT_RUN"
              }
            },
            "required": [
              "validity_status"
            ]
          },
          "then": {
            "properties": {
              "diagnostic_record_results": {
                "maxItems": 0
              },
              "status_decision": {
                "properties": {
                  "decision_basis": {
                    "const": "EXPECTED_NOT_RUN_INVENTORY_AUDIT"
                  },
                  "record_presence_identity_metadata_consulted": {
                    "const": false
                  }
                },
                "description": "For EXPECTED_NOT_RUN, diagnostic execution has not started; do not inspect diagnostic record receipt or identity metadata. Only the frozen run-start ledger is consulted."
              }
            },
            "description": "No diagnostic record-presence or identity metadata is consulted for EXPECTED_NOT_RUN; only the timestamped frozen run-start ledger is used."
          }
        }
      ],
      "description": "Per-variant inventory entry. Cross-file run-ledger matching and timing checks are semantic-validator responsibilities."
    }
  }
}
